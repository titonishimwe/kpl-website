SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-this-password

# Leave DATABASE_URL empty locally to keep SQLite.
# Render sets this from the Postgres instance in render.yaml.
DATABASE_URL=

# Optional local Postgres settings, used only when DATABASE_URL is empty and DB_NAME is set.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Extra HTTPS origins, comma-separated. The Render hostname is added automatically.
# CSRF_TRUSTED_ORIGINS=https://library.example.com
CSRF_TRUSTED_ORIGINS=
